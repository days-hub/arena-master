# Copy this file to .env and fill in your values.
# Get a bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=your-server-id-here
# Webhook for posting tournament notifications to a channel.
# Create one under Channel Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=your-webhook-url-here
# Base URL of the React frontend, used by the bot's !bracket link and as the
# redirect target after a successful Discord login.
FRONTEND_BASE_URL=http://localhost:3000

# Discord OAuth2 login (Developer Portal > your app > OAuth2). These are NOT
# the bot token. Add this redirect URI to the same page:
#   http://localhost:8000/login/oauth2/code/discord
DISCORD_CLIENT_ID=your-oauth-client-id-here
DISCORD_CLIENT_SECRET=your-oauth-client-secret-here
