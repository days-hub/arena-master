# Copy this file to .env and fill in your values.
# Get a bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=your-server-id-here
# Webhook for posting tournament notifications to a channel.
# Create one under Channel Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=your-webhook-url-here
# Base URL of the React frontend, used by the bot's !bracket link and as the
# redirect target after a successful Discord login.
FRONTEND_BASE_URL=http://localhost:3000

# Discord OAuth2 login (Developer Portal > your app > OAuth2). These are NOT
# the bot token. Add this redirect URI to the same page:
#   http://localhost:8000/login/oauth2/code/discord
DISCORD_CLIENT_ID=your-oauth-client-id-here
DISCORD_CLIENT_SECRET=your-oauth-client-secret-here

# Discord user ids granted admin, comma-separated. Admins can manage any
# tournament, including ones created before accounts existed. Enable Developer
# Mode in Discord, then right-click yourself > Copy User ID.
ADMIN_DISCORD_IDS=your-discord-user-id-here

# Shared secret the Discord bot presents to the API. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The bot also sends the command author's Discord id, so its actions run with
# that person's permissions rather than as an unrestricted superuser.
ARENA_SERVICE_KEY=generate-a-long-random-string-here

# Riot Games API key for the League of Legends features (rank on rosters).
# Get one at https://developer.riotgames.com. A Development key expires every
# 24 hours; register a Personal key for one that doesn't. Leave blank and the
# app runs normally with League features switched off.
RIOT_API_KEY=RGAPI-your-key-here
# Platform routing value used when a player doesn't pick one:
# na1 br1 la1 la2 euw1 eun1 tr1 ru kr jp1 oc1 ph2 sg2 th2 tw2 vn2
RIOT_PLATFORM=na1
